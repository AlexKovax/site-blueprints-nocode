---
import Layout from '../layouts/Layout.astro';
import data from '../data/blueprints.json' with { type: 'json' };

const course = data.course;
const topics = data.topics;
const totalLessons = data.all_lessons.length;
---

<Layout title="Blueprints — Les fondations d'une agence no-code" description="Une formation gratuite pour découvrir les coulisses de la création d'agences no-code à travers 10 interviews de fondateurs.">
  <section class="hero container">
    <h1 class="hero__title">Blueprints&nbsp;:<br /><span class="hero__accent">les fondations</span></h1>
    <p class="hero__subtitle">Des retours d'expérience concrets pour construire votre agence no-code — gratuit.</p>
  </section>

  <section class="section container">
    <div class="course-card">
      <div class="course-card__header">
        <span class="badge badge--free">Gratuit</span>
        <h2 class="course-card__title">
          <a href="/cours/">Blueprint&nbsp;: Les fondations d'une agence no-code</a>
        </h2>
      </div>
      <p class="course-card__desc">
        Découvrez les coulisses de la création d'agences no-code à travers une série d'interviews approfondies avec <strong>10 fondateurs d'agences</strong> qui partagent ouvertement leurs succès, leurs échecs et leurs apprentissages. ~15 heures de contenu.
      </p>
      <div class="course-card__meta">
        <span>{topics.length} chapitres</span>
        <span>{totalLessons} leçons</span>
        <span>10 interviews</span>
      </div>
      <a href="/cours/" class="btn btn--outline">Accéder au cours</a>
    </div>
  </section>

  <section class="section container">
    <h2 class="section__title">Les blueprints ne sont pas des formations techniques</h2>
    <p class="section__text">Pour apprendre à utiliser les outils no-code et monter en compétence techniquement, nous recommandons :</p>
    <div class="partners">
      <a href="https://contournement.io" class="partner" target="_blank">
        <strong>Contournement</strong> — Pour bien démarrer
      </a>
      <a href="https://cercledesops.fr" class="partner" target="_blank">
        <strong>Le Cercle des Ops</strong> — Pour pratiquer
      </a>
      <a href="https://mentors.cercledesops.io/" class="partner" target="_blank">
        <strong>Mentoring no-code</strong> — Pour être débloqué.e
      </a>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding: 4rem 0 3rem;
    border-bottom: 3px solid var(--color-text, #000);
  }

  .hero__title {
    font-size: clamp(2.5rem, 6vw, 3.5rem);
    font-weight: 800;
    line-height: 1.05;
    margin-bottom: 1rem;
  }

  .hero__accent {
    color: #2563eb;
  }

  .hero__subtitle {
    font-size: 1.125rem;
    max-width: 500px;
    margin-bottom: 2rem;
    line-height: 1.5;
  }

  .section {
    padding: 2.5rem 0;
  }

  .section__title {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .section__text {
    color: #555;
    margin-bottom: 1.5rem;
  }

  .course-card {
    border: 3px solid var(--color-text, #000);
    padding: 2rem;
    transition: all 0.1s;
  }

  .course-card:hover {
    transform: translate(-3px, -3px);
    box-shadow: 6px 6px 0 var(--color-text, #000);
  }

  .course-card__header {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .course-card__title {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0;
  }

  .course-card__title a {
    text-decoration: none;
    color: var(--color-text, #000);
  }

  .course-card__title a:hover {
    text-decoration: underline;
  }

  .course-card__desc {
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .course-card__meta {
    display: flex;
    gap: 1.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
  }

  .partners {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .partner {
    display: block;
    border: 2px solid var(--color-text, #000);
    padding: 1rem 1.25rem;
    text-decoration: none;
    color: var(--color-text, #000);
    transition: all 0.1s;
    font-size: 0.95rem;
  }

  .partner:hover {
    transform: translate(-2px, -2px);
    box-shadow: 4px 4px 0 var(--color-text, #000);
  }

  .partner strong {
    font-weight: 700;
  }
</style>